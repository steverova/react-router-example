{
  "name": "react-router-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "pnpm build && vite preview",
    "cf-typegen": "wrangler types",
    "drizzle:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config=drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply react-router-example --local",
    "db:migrate-production": "wrangler d1 migrations apply react-router-example --remote",
    "db:local": "wrangler d1 execute react-router-example --local --file=./drizzle/seed.sql",
    "db:remote": "wrangler d1 execute react-router-example --remote --file=./drizzle/seed.sql",
    "db:reset:local": "pnpm wrangler d1 execute react-router-example --local --command \"DELETE FROM d1_migrations; DROP TABLE IF EXISTS activities; DROP TABLE IF EXISTS projects; DROP TABLE IF EXISTS clients; DROP TABLE IF EXISTS sessions; DROP TABLE IF EXISTS refresh_tokens; DROP TABLE IF EXISTS password_reset_tokens; DROP TABLE IF EXISTS login_attempts; DROP TABLE IF EXISTS credentials; DROP TABLE IF EXISTS users;\" && pnpm db:migrate && pnpm db:local",
    "db:reset:remote": "pnpm wrangler d1 execute react-router-example --remote --command \"DELETE FROM d1_migrations; DROP TABLE IF EXISTS activities; DROP TABLE IF EXISTS projects; DROP TABLE IF EXISTS clients; DROP TABLE IF EXISTS sessions; DROP TABLE IF EXISTS refresh_tokens; DROP TABLE IF EXISTS password_reset_tokens; DROP TABLE IF EXISTS login_attempts; DROP TABLE IF EXISTS credentials; DROP TABLE IF EXISTS users;\" && pnpm db:migrate-production && pnpm db:remote",
    "postinstall": "wrangler types",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@react-router/node": "8.2.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "isbot": "^5",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.24.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.81.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "5.0.0-rc.0",
    "react-router": "8.2.0",
    "react-select": "^5.10.2",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8",
    "wait-on": "^9.0.10",
    "wrangler": "^4.111.0"
  }
}
