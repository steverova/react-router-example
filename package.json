{
  "name": "react-router-example",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "vite preview",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:studio": "drizzle-kit studio --config=drizzle.config.sqlite.ts",
    "db:generate:mysql": "drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:push:mysql": "drizzle-kit push --config=drizzle.config.mysql.ts",
    "db:migrate:mysql": "drizzle-kit migrate --config=drizzle.config.mysql.ts",
    "db:drop:mysql": "drizzle-kit drop --config=drizzle.config.mysql.ts",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:push:sqlite": "drizzle-kit push --config=drizzle.config.sqlite.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config=drizzle.config.sqlite.ts",
    "db:drop:sqlite": "drizzle-kit drop --config=drizzle.config.sqlite.ts",
    "db:seed": "npx tsx app/db/seed.ts",
    "db:studio:turso": "drizzle-kit studio --config=drizzle.config.turso.ts",
    "db:generate:turso": "drizzle-kit generate --config=drizzle.config.turso.ts",
    "db:push:turso": "drizzle-kit push --config=drizzle.config.turso.ts",
    "db:migrate:turso": "drizzle-kit migrate --config=drizzle.config.turso.ts",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "^0.17.4",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "isbot": "^5",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.24.0",
    "mysql2": "^3.22.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.81.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "5.0.0-rc.0",
    "react-router": "7.15.1",
    "react-select": "^5.10.2",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8"
  }
}
